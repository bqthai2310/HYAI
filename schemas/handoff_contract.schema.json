{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HandoffContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "source_department",
    "destination_department",
    "subject_refs",
    "input_contract",
    "output_acceptance_refs",
    "unresolved_risks",
    "content_digest"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^handoff_"
    },
    "source_department": {
      "type": "string"
    },
    "destination_department": {
      "type": "string"
    },
    "subject_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "input_contract": {
      "type": "string",
      "minLength": 1
    },
    "output_acceptance_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "unresolved_risks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "content_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "encoding",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,31}$"
        },
        "encoding": {
          "enum": [
            "hex",
            "base64url"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 16,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    }
  }
}
