{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanaryPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canary_id",
    "subject_ref",
    "scope",
    "success_thresholds",
    "failure_thresholds",
    "rollback_ref",
    "duration_or_sample",
    "authority_ref"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "canary_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "success_thresholds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failure_thresholds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollback_ref": {
      "type": "string",
      "minLength": 1
    },
    "duration_or_sample": {
      "type": "string",
      "minLength": 1
    },
    "authority_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
