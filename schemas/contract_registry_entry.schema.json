{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContractRegistryEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "object_name",
    "owner",
    "schema_path",
    "writer_commands",
    "lifecycle_family"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^contract_"
    },
    "object_name": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "schema_path": {
      "type": "string",
      "pattern": "^19_schemas/"
    },
    "writer_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "lifecycle_family": {
      "type": "string",
      "minLength": 1
    }
  }
}
