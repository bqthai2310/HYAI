{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthorityRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_request_id",
    "requester",
    "action",
    "resource",
    "required_class",
    "reason",
    "risk_summary",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "authority_request_id": {
      "type": "string",
      "minLength": 1
    },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_type",
        "id"
      ],
      "properties": {
        "principal_type": {
          "type": "string",
          "enum": [
            "PO",
            "ARCHITECT",
            "EXECUTOR",
            "INDEPENDENT_REVIEWER",
            "ASSURANCE_SERVICE",
            "RUNTIME_WORKER",
            "POLICY_ENGINE",
            "EVOLUTION_CONTROLLER",
            "RELEASE_MANAGER",
            "SYSTEM"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "string",
      "minLength": 1
    },
    "required_class": {
      "enum": [
        "A1",
        "A2",
        "A3",
        "A4"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "risk_summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PENDING",
        "APPROVED",
        "DENIED",
        "EXPIRED"
      ]
    },
    "decision_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
