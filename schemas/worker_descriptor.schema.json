{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkerDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "worker_id",
    "node_id",
    "capabilities",
    "status",
    "trust_class",
    "registered_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "pattern": "^node_"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "READY",
        "BUSY",
        "DRAINING",
        "UNHEALTHY",
        "OFFLINE"
      ]
    },
    "trust_class": {
      "enum": [
        "UNTRUSTED",
        "LIMITED",
        "TRUSTED",
        "HIGH_TRUST"
      ]
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
