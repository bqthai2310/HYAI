{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceLease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lease_id",
    "task_id",
    "task_revision",
    "worker_id",
    "permitted_actions",
    "expires_at",
    "issued_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "lease_id": {
      "type": "string",
      "pattern": "^lease_"
    },
    "task_id": {
      "type": "string",
      "pattern": "^task_"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 0
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "permitted_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "budget_ref": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
