{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProgramSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "goal_id",
    "product_refs",
    "product_contract_refs",
    "name",
    "objective",
    "workstream_ids",
    "state",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "program_id": {
      "type": "string",
      "pattern": "^prog_"
    },
    "goal_id": {
      "type": "string",
      "pattern": "^goal_"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "workstream_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ws_"
      },
      "uniqueItems": true
    },
    "state": {
      "enum": [
        "PLANNED",
        "READY",
        "RUNNING",
        "VERIFYING",
        "COMPLETE",
        "CORRECTION",
        "BLOCKED",
        "CANCELLED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "product_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^product_"
      },
      "uniqueItems": true
    },
    "product_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^productcontract_"
      },
      "uniqueItems": true
    }
  }
}
