{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillBinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "task_id",
    "attempt_id",
    "skill_id",
    "skill_version",
    "skill_digest",
    "resolved_capabilities",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^skillbind_"
    },
    "task_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "skill_id": {
      "type": "string",
      "pattern": "^skill_"
    },
    "skill_version": {
      "type": "string"
    },
    "skill_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "encoding",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,31}$"
        },
        "encoding": {
          "enum": [
            "hex",
            "base64url"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 16,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "resolved_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
