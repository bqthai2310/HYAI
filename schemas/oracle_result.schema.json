{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OracleResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "oracle_result_id",
    "test_id",
    "subject_digest",
    "result",
    "assertion_results",
    "raw_evidence_refs",
    "executed_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "oracle_result_id": {
      "type": "string",
      "pattern": "^oracleres_"
    },
    "test_id": {
      "type": "string",
      "pattern": "^L9-T-\\d{3}$"
    },
    "subject_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "encoding",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,31}$"
        },
        "encoding": {
          "enum": [
            "hex",
            "base64url"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 16,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "assertion_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "assertion",
          "result"
        ],
        "properties": {
          "assertion": {
            "type": "string"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "raw_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "PASS"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "assertion_results": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assertion",
                "result"
              ],
              "properties": {
                "assertion": {
                  "type": "string",
                  "minLength": 1
                },
                "result": {
                  "const": "PASS"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "FAIL"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "assertion_results": {
            "contains": {
              "type": "object",
              "required": [
                "result"
              ],
              "properties": {
                "result": {
                  "const": "FAIL"
                }
              }
            },
            "minContains": 1
          }
        }
      }
    }
  ]
}
