{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeliveryReadinessRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "readiness_id",
    "product_ref",
    "delivery_contract_ref",
    "delivery_contract_revision",
    "delivery_contract_digest",
    "release_subject_digest",
    "state",
    "criterion_results",
    "independent_review_ref",
    "issued_at",
    "issued_by"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "readiness_id": {
      "type": "string",
      "pattern": "^deliveryready_"
    },
    "product_ref": {
      "type": "string",
      "pattern": "^product_"
    },
    "release_subject_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "encoding",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,31}$"
        },
        "encoding": {
          "enum": [
            "hex",
            "base64url"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 16,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "state": {
      "enum": [
        "NOT_READY",
        "CORRECTION_REQUIRED",
        "BLOCKED",
        "DELIVERY_READY"
      ]
    },
    "criterion_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "result",
          "evidence_refs"
        ],
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "independent_review_ref": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issued_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_type",
        "id"
      ],
      "properties": {
        "principal_type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "delivery_contract_ref": {
      "type": "string",
      "pattern": "^deliverycontract_"
    },
    "delivery_contract_revision": {
      "type": "integer",
      "minimum": 1
    },
    "delivery_contract_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "encoding",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,31}$"
        },
        "encoding": {
          "enum": [
            "hex",
            "base64url"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 16,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "DELIVERY_READY"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "criterion_results": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "criterion_id",
                "result",
                "evidence_refs"
              ],
              "properties": {
                "criterion_id": {
                  "type": "string",
                  "minLength": 1
                },
                "result": {
                  "const": "PASS"
                },
                "evidence_refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "independent_review_ref": {
            "type": "string",
            "pattern": "^(verdict_|reviewatt_)"
          },
          "issued_by": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "principal_type",
              "id"
            ],
            "properties": {
              "principal_type": {
                "enum": [
                  "ASSURANCE_SERVICE",
                  "SYSTEM"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
