{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AcceptanceResults",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_subject_id",
    "criterion_results"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "review_subject_id": {
      "type": "string",
      "minLength": 1
    },
    "criterion_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "result",
          "evidence_refs"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "INSUFFICIENT_EVIDENCE"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "verification_method": {
            "type": "string"
          },
          "verification_ref": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "PASS"
                }
              }
            },
            "then": {
              "properties": {
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
