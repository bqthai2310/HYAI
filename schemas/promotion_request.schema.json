{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PromotionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "promotion_id",
    "target_environment",
    "review_subject_id",
    "pass_verdict_refs",
    "deployment_plan_ref",
    "rollback_plan_ref",
    "risk_class",
    "requested_by"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "promotion_id": {
      "type": "string",
      "minLength": 1
    },
    "target_environment": {
      "type": "string",
      "minLength": 1
    },
    "review_subject_id": {
      "type": "string",
      "minLength": 1
    },
    "pass_verdict_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deployment_plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "rollback_plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "risk_class": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "requested_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_type",
        "id"
      ],
      "properties": {
        "principal_type": {
          "type": "string",
          "enum": [
            "PO",
            "ARCHITECT",
            "EXECUTOR",
            "INDEPENDENT_REVIEWER",
            "ASSURANCE_SERVICE",
            "RUNTIME_WORKER",
            "POLICY_ENGINE",
            "EVOLUTION_CONTROLLER",
            "RELEASE_MANAGER",
            "SYSTEM"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authority_approval_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
