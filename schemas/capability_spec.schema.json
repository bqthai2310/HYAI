{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilitySpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_id",
    "name",
    "input_contract",
    "output_contract",
    "permissions",
    "quality_class",
    "risk_class"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "capability_id": {
      "type": "string",
      "pattern": "^cap_"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "input_contract": {
      "type": "string",
      "minLength": 1
    },
    "output_contract": {
      "type": "string",
      "minLength": 1
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "quality_class": {
      "enum": [
        "STANDARD",
        "HIGH",
        "CRITICAL"
      ]
    },
    "risk_class": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "evidence_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "isolation_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
