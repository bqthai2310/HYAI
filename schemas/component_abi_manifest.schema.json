{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComponentABIManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "abi_manifest_id",
    "component_id",
    "component_version",
    "entrypoint_kind",
    "exported_capabilities",
    "input_schema_refs",
    "output_schema_refs",
    "permission_refs",
    "compatibility_ref",
    "artifact_digest"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "abi_manifest_id": {
      "type": "string",
      "pattern": "^abi_"
    },
    "component_id": {
      "type": "string"
    },
    "component_version": {
      "type": "string"
    },
    "entrypoint_kind": {
      "enum": [
        "NATIVE",
        "PROCESS",
        "CONTAINER",
        "WASM_COMPONENT",
        "REMOTE_SERVICE",
        "OTHER"
      ]
    },
    "exported_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "input_schema_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "output_schema_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "permission_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "compatibility_ref": {
      "type": "string",
      "pattern": "^compat_"
    },
    "artifact_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "encoding",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,31}$"
        },
        "encoding": {
          "enum": [
            "hex",
            "base64url"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 16,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    }
  }
}
